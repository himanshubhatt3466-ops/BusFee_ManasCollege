{
  "name": "manas-college-bus-fee-manager",
  "version": "1.0.0",
  "description": "Manas College Science Technology & Management Bus Fee Management",
  "main": "main.js",
  "author": "Manas College",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^34.3.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "in.mcstm.busfees",
    "productName": "Manas College Bus Fee Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Manas College Bus Fee Manager"
    }
  }
}